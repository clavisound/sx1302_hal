[Unit]
Description=SX1302 GPIO ownership for dialout group
Documentation=https://github.com/Lora-net/sx1302_hal
After=sysinit.target
Before=sx1302-hal-pkt-fwd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/sx1302-hal/sx1302-gpio-perms.sh

[Install]
WantedBy=multi-user.target
